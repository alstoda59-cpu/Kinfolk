{
  "name": "kinfolk-social-mobile",
  "version": "0.1.0-alpha.1",
  "private": true,
  "scripts": {
    "prepare:web": "node scripts/prepare-web.mjs",
    "android:init": "npx cap add android",
    "ios:init": "npx cap add ios",
    "sync": "npm run prepare:web && npx cap sync",
    "android:open": "npx cap open android",
    "ios:open": "npx cap open ios",
    "alpha:verify": "node scripts/verify-alpha-package.mjs && node --test tests/alpha-backend-config.test.mjs",
    "alpha:config:test": "node --test tests/alpha-backend-config.test.mjs"
  },
  "dependencies": {
    "@capacitor/core": "7.6.9",
    "@capacitor/android": "7.6.9",
    "@capacitor/ios": "7.6.9",
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "esbuild": "0.25.12"
  },
  "engines": {
    "node": ">=22"
  }
}

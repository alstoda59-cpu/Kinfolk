{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/kinfolk-social/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/kinfolk-social/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
